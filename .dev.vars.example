PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Brevo — leave empty in dev to simulate submissions.
BREVO_API_KEY=
BREVO_LIST_WAITLIST=
BREVO_LIST_PIONEERS=
BREVO_LIST_AGENTS=

CONTACT_INBOX=
PUBLIC_CF_ANALYTICS_TOKEN=
