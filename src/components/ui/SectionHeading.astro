---
/**
 * Section heading in the layout reference's style: a small eyebrow with a dot,
 * then a two-tone title (the highlighted end in the brand color).
 */
interface Props {
  eyebrow?: string;
  title: string;
  highlight?: string;
  description?: string;
  align?: "left" | "center";
  level?: "h1" | "h2";
  onDark?: boolean;
  class?: string;
}

const {
  eyebrow,
  title,
  highlight,
  description,
  align = "left",
  level: Heading = "h2",
  onDark = false,
  class: className = "",
} = Astro.props;
---

<header class:list={["max-w-2xl", align === "center" && "mx-auto text-center", className]}>
  {eyebrow && (
    <p
      class:list={[
        "mb-4 inline-flex items-center gap-2 text-xs font-semibold tracking-wide uppercase",
        onDark ? "text-forest-pale" : "text-forest",
      ]}
    >
      <span class:list={["size-1.5 rounded-full", onDark ? "bg-forest-pale" : "bg-forest"]} aria-hidden="true" />
      {eyebrow}
    </p>
  )}
  <Heading class:list={[Heading === "h1" ? "text-h1" : "text-h2", onDark ? "text-white" : "text-ink"]}>
    {title}
    {highlight && (
      <>
        {" "}
        <span class:list={onDark ? "text-forest-pale" : "text-forest"}>{highlight}</span>
      </>
    )}
  </Heading>
  {description && <p class:list={["mt-4 text-lead", onDark ? "text-white/80" : "text-gray-dark"]}>{description}</p>}
</header>
