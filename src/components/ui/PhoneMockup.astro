---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import BrandPattern from "../brand/BrandPattern.astro";
import Logo from "../brand/Logo.astro";

/**
 * CSS phone frame. Pass a screenshot (src/assets/apps/) when the founder supplies it;
 * until then the screen shows the brand splash (forest + monogram texture).
 */
interface Props {
  screenshot?: ImageMetadata;
  alt: string;
  label?: string;
  priority?: boolean;
  class?: string;
}

const { screenshot, alt, label, priority = false, class: className = "" } = Astro.props;
---

<figure class:list={["relative mx-auto w-full max-w-[280px]", className]}>
  <div class="relative rounded-[2.75rem] bg-ink p-2.5 shadow-lift">
    <div class="relative aspect-[9/19.5] overflow-hidden rounded-[2.25rem] bg-forest">
      {screenshot ? (
        <Image
          src={screenshot}
          alt={alt}
          widths={[280, 560]}
          sizes="280px"
          class="h-full w-full object-cover"
          loading={priority ? "eager" : "lazy"}
          fetchpriority={priority ? "high" : "auto"}
        />
      ) : (
        <div
          role="img"
          aria-label={alt}
          class="relative isolate flex h-full flex-col items-center justify-center gap-4"
        >
          <BrandPattern scale={28} />
          <Logo variant="monogram" color="white" height={56} />
          {label && <span class="px-6 text-center text-sm font-medium text-white/85">{label}</span>}
        </div>
      )}
      <span class="absolute top-2.5 left-1/2 h-6 w-24 -translate-x-1/2 rounded-full bg-ink" aria-hidden="true"></span>
    </div>
  </div>
</figure>
