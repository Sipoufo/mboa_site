---
import type { IconName } from "@/lib/icons";
import Icon from "./Icon.astro";

/**
 * Buttons — Doc 05 §6.1, with the website contrast rule (CLAUDE.md › Coral & Contrast):
 * the primary button uses coral-dark so its white label meets WCAG AA.
 * On forest surfaces use `inverse` (coral on forest is forbidden).
 */
interface Props {
  href?: string;
  type?: "button" | "submit";
  variant?: "primary" | "secondary" | "outline" | "ghost" | "inverse";
  size?: "lg" | "md" | "sm";
  icon?: IconName | false;
  external?: boolean;
  class?: string;
  [key: `data-${string}`]: string | undefined;
  "aria-label"?: string;
}

const {
  href,
  type = "button",
  variant = "primary",
  size = "md",
  icon = "arrow-right",
  external = false,
  class: className = "",
  ...rest
} = Astro.props;

const variants = {
  primary: "bg-coral-dark text-white hover:shadow-lift",
  secondary: "bg-forest text-white hover:bg-forest-light hover:shadow-lift",
  outline: "border-[1.5px] border-forest text-forest hover:bg-forest-pale",
  ghost: "text-gray-dark hover:text-ink",
  inverse: "bg-white text-forest hover:bg-forest-pale hover:shadow-lift",
};

const sizes = {
  lg: "h-13 px-5 text-base gap-2.5",
  md: "h-11 px-4 text-sm gap-2",
  sm: "h-9 px-3 text-sm gap-1.5",
};

const classes = [
  "group inline-flex items-center justify-center rounded-button font-sans font-semibold whitespace-nowrap",
  "transition-[transform,box-shadow,background-color,color] duration-300 ease-out-soft",
  "hover:-translate-y-0.5 active:translate-y-0 active:scale-[0.98]",
  variants[variant],
  sizes[size],
  className,
];

const iconSize = size === "lg" ? 20 : 18;
---

{href ? (
  <a href={href} class:list={classes} {...(external && { target: "_blank", rel: "noopener noreferrer" })} {...rest}>
    <slot />
    {icon && <Icon name={icon} size={iconSize} class="transition-transform duration-300 group-hover:translate-x-1" />}
  </a>
) : (
  <button type={type} class:list={classes} {...rest}>
    <slot />
    {icon && <Icon name={icon} size={iconSize} class="transition-transform duration-300 group-hover:translate-x-1" />}
  </button>
)}
