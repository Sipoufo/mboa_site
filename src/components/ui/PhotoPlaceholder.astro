---
import type { IconName } from "@/lib/icons";
import Icon from "./Icon.astro";

/**
 * Stand-in for a photo until the brand shoot (CLAUDE.md › Brand Rules).
 * `shot` describes the intended photo — it is the accessible name and the brief for the shoot.
 */
interface Props {
  shot: string;
  icon?: IconName;
  ratio?: "4/3" | "16/9" | "1/1" | "3/4";
  class?: string;
}

const { shot, icon = "camera", ratio = "4/3", class: className = "" } = Astro.props;

const ratios = {
  "4/3": "aspect-[4/3]",
  "16/9": "aspect-video",
  "1/1": "aspect-square",
  "3/4": "aspect-[3/4]",
};
---

<div
  role="img"
  aria-label={shot}
  data-placeholder="photo"
  class:list={[
    "relative isolate flex items-center justify-center overflow-hidden rounded-card bg-warm-white",
    ratios[ratio],
    className,
  ]}
>
  <span class="absolute -top-10 -right-10 -z-10 size-40 rounded-full bg-forest-pale" aria-hidden="true"></span>
  <span class="absolute -bottom-12 -left-8 -z-10 size-32 rounded-full bg-coral-pale" aria-hidden="true"></span>
  <span class="flex size-14 items-center justify-center rounded-full bg-white text-forest shadow-card">
    <Icon name={icon} size={24} />
  </span>
</div>
