---
import Icon from "@/components/ui/Icon.astro";
import PhoneMockup from "@/components/ui/PhoneMockup.astro";
import Section from "@/components/ui/Section.astro";
import SectionHeading from "@/components/ui/SectionHeading.astro";
import type { Locale } from "@/i18n/locales";
import { t, type TranslationKey } from "@/i18n/utils";
import type { IconName } from "@/lib/icons";

/**
 * Trust mechanisms around a central phone (layout reference: product with numbered features).
 * Sources: Doc 18 §1.3 (without the competitor column), Doc 10 M01bis, M05, M08, M09, M12, M16.
 */
interface Props {
  locale: Locale;
}

const { locale } = Astro.props;

const features: { n: number; icon: IconName }[] = [
  { n: 1, icon: "user-check" },
  { n: 2, icon: "badge-check" },
  { n: 3, icon: "calendar-check" },
  { n: 4, icon: "file-signature" },
  { n: 5, icon: "gauge" },
  { n: 6, icon: "message-circle" },
  { n: 7, icon: "trendingUp" },
  { n: 8, icon: "chartPie" },
];

const left = features.slice(0, 4);
const right = features.slice(4);
const title = (n: number) => t(locale, `home.trust.f${n}Title` as TranslationKey);
const text = (n: number) => t(locale, `home.trust.f${n}Text` as TranslationKey);
---

<Section tone="forest-dark" pattern>
  <SectionHeading
    onDark
    align="center"
    eyebrow={t(locale, "home.trust.eyebrow")}
    title={t(locale, "home.trust.heading")}
    highlight={t(locale, "home.trust.highlight")}
    description={t(locale, "home.trust.description")}
  />

  <div class="mt-14 grid items-center gap-10 lg:grid-cols-[1fr_auto_1fr] lg:gap-12">
    {[left, right].map((column, side) => (
      <ul class:list={["flex flex-col gap-6", side === 0 ? "lg:order-1 lg:text-right" : "lg:order-3"]}>
        {column.map(({ n, icon }) => (
          <li
            class:list={["flex gap-4", side === 0 && "lg:flex-row-reverse"]}
            data-reveal
            style={`--reveal-delay: ${(n - 1) * 90}ms`}
          >
            <span class="relative flex size-12 shrink-0 items-center justify-center rounded-full bg-white/10 text-forest-pale ring-1 ring-white/15">
              <Icon name={icon} size={22} />
              <span class="absolute -top-1.5 -right-1.5 flex size-6 items-center justify-center rounded-full bg-forest-pale text-[11px] font-bold text-forest-dark">
                {String(n).padStart(2, "0")}
              </span>
            </span>
            <div>
              <h3 class="text-h3 text-white">{title(n)}</h3>
              <p class="mt-1 text-sm text-white/75">{text(n)}</p>
            </div>
          </li>
        ))}
      </ul>
    ))}
    <div class="order-first mx-auto w-56 lg:order-2 lg:w-64" data-reveal>
      <PhoneMockup alt={t(locale, "home.trust.phoneAlt")} />
    </div>
  </div>
</Section>
