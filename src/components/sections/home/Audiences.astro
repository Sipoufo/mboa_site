---
import Icon from "@/components/ui/Icon.astro";
import Section from "@/components/ui/Section.astro";
import SectionHeading from "@/components/ui/SectionHeading.astro";
import type { Locale } from "@/i18n/locales";
import { localizedPath, t, type TranslationKey } from "@/i18n/utils";
import type { Profile } from "@/lib/forms/waitlist-fields";
import type { IconName } from "@/lib/icons";

/**
 * Who Mboa is for — replaces the layout reference's testimonial cards with true content.
 * Messages per target: Doc 18 §1.2. Each card opens the waitlist with the profile preselected.
 */
interface Props {
  locale: Locale;
}

const { locale } = Astro.props;

const audiences: { key: "tenants" | "owners" | "agents"; icon: IconName; profile: Profile }[] = [
  { key: "tenants", icon: "search", profile: "tenant" },
  { key: "owners", icon: "key-round", profile: "owner" },
  { key: "agents", icon: "handshake", profile: "agent" },
];

const waitlist = localizedPath("waitlist", locale);
const copy = (key: string, field: string) => t(locale, `home.audiences.${key}${field}` as TranslationKey);
---

<Section tone="white">
  <SectionHeading
    eyebrow={t(locale, "home.audiences.eyebrow")}
    title={t(locale, "home.audiences.heading")}
    highlight={t(locale, "home.audiences.highlight")}
  />

  <ul class="-mx-5 mt-12 flex snap-x snap-mandatory scroll-px-5 gap-5 overflow-x-auto px-5 pb-4 md:mx-0 md:grid md:grid-cols-3 md:overflow-visible md:px-0 md:pb-0">
    {audiences.map(({ key, icon, profile }, index) => (
      <li
        class="group relative flex w-[82%] shrink-0 snap-start flex-col overflow-hidden rounded-card border-t-4 border-forest bg-white p-6 shadow-card transition-[transform,box-shadow] duration-500 ease-out-soft hover:-translate-y-1 hover:shadow-lift md:w-auto"
        data-reveal
        style={`--reveal-delay: ${index * 120}ms`}
      >
        <span class="flex size-12 items-center justify-center rounded-full bg-forest-pale text-forest">
          <Icon name={icon} size={24} />
        </span>
        <h3 class="mt-5 text-h3">{copy(key, "Title")}</h3>
        <p class="mt-3 flex-1 text-gray-dark">{copy(key, "Text")}</p>
        <a
          href={`${waitlist}?profil=${profile}`}
          class="mt-6 inline-flex items-center gap-2 font-semibold text-forest after:absolute after:inset-0 hover:text-forest-light"
        >
          {copy(key, "Cta")}
          <Icon name="arrow-right" size={18} class="transition-transform duration-300 group-hover:translate-x-1" />
        </a>
      </li>
    ))}
  </ul>
</Section>
