---
import BrandPattern from "@/components/brand/BrandPattern.astro";
import DecorDiscs from "@/components/brand/DecorDiscs.astro";
import WaitlistForm from "@/components/islands/WaitlistForm.tsx";
import { waitlistCopy } from "@/components/islands/waitlist-copy";
import WaitlistCount from "@/components/sections/WaitlistCount.astro";
import Card from "@/components/ui/Card.astro";
import Container from "@/components/ui/Container.astro";
import Icon from "@/components/ui/Icon.astro";
import Section from "@/components/ui/Section.astro";
import SectionHeading from "@/components/ui/SectionHeading.astro";
import { localeTags, type Locale } from "@/i18n/locales";
import { formatMonth, localizedPath, t } from "@/i18n/utils";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { TURNSTILE_TEST_SITE_KEY } from "@/lib/forms/turnstile";
import { settings } from "@/lib/settings";

/** Waitlist page — the site's main call to action (CLAUDE.md › Purpose). Sources: Doc 18 §4.1, Doc 20 §6. */
interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const date = formatMonth(settings.launch.mvpDate, locale);

const turnstileSiteKey =
  import.meta.env.PUBLIC_TURNSTILE_SITE_KEY || (import.meta.env.DEV ? TURNSTILE_TEST_SITE_KEY : "");
if (!turnstileSiteKey) console.warn("[waitlist] PUBLIC_TURNSTILE_SITE_KEY is not set — submissions will be refused");

const points = [
  { icon: "sparkles", text: t(locale, "waitlist.points.quick") },
  { icon: "check", text: t(locale, "waitlist.points.unsubscribe") },
  { icon: "shield-check", text: t(locale, "waitlist.points.noResale") },
] as const;

const steps = [
  { title: t(locale, "waitlist.next.step1Title"), text: t(locale, "waitlist.next.step1Text") },
  { title: t(locale, "waitlist.next.step2Title"), text: t(locale, "waitlist.next.step2Text") },
  { title: t(locale, "waitlist.next.step3Title"), text: t(locale, "waitlist.next.step3Text", { date }) },
];

const faq = ([1, 2, 3, 4, 5] as const).map((n) => ({
  question: t(locale, `waitlist.faq.q${n}`),
  answer: t(locale, `waitlist.faq.a${n}`, { date }),
  // The data question links to the privacy policy.
  privacyLink: n === 4,
}));
---

<BaseLayout
  locale={locale}
  routeKey="waitlist"
  title={t(locale, "waitlist.title")}
  description={t(locale, "waitlist.description", { date })}
>
  <section class="relative isolate overflow-hidden">
    <DecorDiscs />
    <Container class="grid gap-12 py-14 md:py-20 lg:grid-cols-[1fr_1.05fr] lg:items-start lg:gap-16">
      <div class="lg:sticky lg:top-32">
        <SectionHeading
          level="h1"
          eyebrow={t(locale, "waitlist.eyebrow")}
          title={t(locale, "waitlist.heading")}
          highlight={t(locale, "waitlist.highlight")}
          description={t(locale, "waitlist.lead", { date })}
        />
        <ul class="mt-8 flex flex-col gap-3">
          {points.map((point) => (
            <li class="flex items-center gap-3 text-ink">
              <span class="flex size-9 items-center justify-center rounded-full bg-forest-pale text-forest">
                <Icon name={point.icon} size={18} />
              </span>
              {point.text}
            </li>
          ))}
        </ul>
        <div class="mt-8 min-h-10">
          <WaitlistCount template={t(locale, "waitlist.counter")} numberLocale={localeTags[locale]} />
        </div>
      </div>

      <Card class="p-6 md:p-8">
        <h2 class="mb-6 text-h3">{t(locale, "waitlist.formTitle")}</h2>
        <WaitlistForm client:idle copy={waitlistCopy(locale)} turnstileSiteKey={turnstileSiteKey} />
      </Card>
    </Container>
  </section>

  <Section tone="forest-dark" pattern>
    <SectionHeading
      onDark
      align="center"
      eyebrow={t(locale, "waitlist.next.eyebrow")}
      title={t(locale, "waitlist.next.heading")}
      highlight={t(locale, "waitlist.next.highlight")}
    />
    <ol class="mt-12 grid gap-6 md:grid-cols-3">
      {steps.map((step, index) => (
        <li
          class="relative rounded-card bg-white/6 p-6 ring-1 ring-white/12 backdrop-blur-sm"
          data-reveal
          style={`--reveal-delay: ${index * 120}ms`}
        >
          <span class="font-display text-5xl font-extrabold text-forest-light" aria-hidden="true">
            {String(index + 1).padStart(2, "0")}
          </span>
          <h3 class="mt-4 text-h3 text-white">{step.title}</h3>
          <p class="mt-2 text-white/80">{step.text}</p>
        </li>
      ))}
    </ol>
  </Section>

  <Section tone="white">
    <div class="grid gap-12 lg:grid-cols-[1fr_1.4fr]">
      <div class="relative isolate self-start overflow-hidden rounded-card bg-forest p-8 text-white" data-reveal>
        <BrandPattern />
        <Icon name="key-round" size={32} class="text-forest-pale" />
        <h2 class="mt-4 text-h3 text-white">{t(locale, "waitlist.pros.title")}</h2>
        <p class="mt-3 text-white/85">{t(locale, "waitlist.pros.text")}</p>
      </div>

      <div>
        <h2 class="text-h2">{t(locale, "waitlist.faq.heading")}</h2>
        <div class="mt-6 divide-y divide-gray-light border-y border-gray-light">
          {faq.map((item) => (
            <details class="group py-1">
              <summary class="flex cursor-pointer list-none items-center justify-between gap-4 py-4 font-display text-lg font-semibold text-ink marker:hidden [&::-webkit-details-marker]:hidden">
                {item.question}
                <span class="flex size-8 shrink-0 items-center justify-center rounded-full bg-forest-pale text-forest transition-transform duration-300 group-open:rotate-45">
                  <svg
                    width="16"
                    height="16"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    aria-hidden="true"
                  >
                    <path d="M12 5v14M5 12h14" />
                  </svg>
                </span>
              </summary>
              <p class="pr-12 pb-5 text-gray-dark">
                {item.answer}
                {item.privacyLink && (
                  <>
                    {" "}
                    <a
                      href={localizedPath("privacy", locale)}
                      class="font-medium text-forest underline underline-offset-2"
                    >
                      {t(locale, "nav.privacy")}
                    </a>
                  </>
                )}
              </p>
            </details>
          ))}
        </div>
      </div>
    </div>
  </Section>
</BaseLayout>
