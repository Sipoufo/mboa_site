---
/**
 * Soft floating discs that give depth without gradients (Doc 05 §5.3, "MboaDecorDiscs").
 * Purely decorative; the float animation stops under prefers-reduced-motion.
 */
interface Props {
  variant?: "light" | "dark";
  class?: string;
}

const { variant = "light", class: className = "" } = Astro.props;

const color = variant === "dark" ? "bg-forest-light/25" : "bg-forest-pale";
const accent = variant === "dark" ? "bg-white/8" : "bg-coral-pale";
---

<div class:list={["pointer-events-none absolute inset-0 -z-10", className]} aria-hidden="true">
  <span class:list={["disc absolute -top-24 -right-20 size-72 rounded-full md:size-96", color]}></span>
  <span class:list={["disc disc-slow absolute bottom-[-6rem] left-[-5rem] size-64 rounded-full", accent]}></span>
  <span class:list={["disc absolute top-1/3 left-1/2 size-24 rounded-full", color]}></span>
</div>

<style>
  .disc {
    animation: float 14s ease-in-out infinite alternate;
  }

  .disc-slow {
    animation-duration: 20s;
  }

  @keyframes float {
    from {
      transform: translate3d(0, 0, 0);
    }
    to {
      transform: translate3d(0, -18px, 0) scale(1.04);
    }
  }
</style>
