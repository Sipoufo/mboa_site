---
import type { Locale } from "@/i18n/locales";
import { formatMonth, localizedPath, t } from "@/i18n/utils";
import { settings } from "@/lib/settings";
import Container from "../ui/Container.astro";
import Icon from "../ui/Icon.astro";

/** Thin announcement bar above the header (the layout reference's top strip). */
interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const launchDate = formatMonth(settings.launch.mvpDate, locale);
const { email } = settings.contact;
---

<div class="bg-forest text-white">
  <Container class="flex h-10 items-center justify-between gap-4 text-xs md:text-sm">
    <p class="flex min-w-0 items-center gap-2">
      <Icon name="calendar" size={16} class="text-forest-pale" />
      <span class="truncate">{t(locale, "topbar.launch", { date: launchDate })}</span>
      {!settings.launch.appsLive && (
        <a
          href={localizedPath("waitlist", locale)}
          class="hidden font-semibold underline decoration-white/40 underline-offset-4 transition-colors hover:decoration-white sm:inline"
        >
          {t(locale, "topbar.cta")}
        </a>
      )}
    </p>
    {email && (
      <a href={`mailto:${email}`} class="hidden items-center gap-1.5 text-white/85 hover:text-white md:inline-flex">
        <Icon name="mail" size={16} />
        {email}
      </a>
    )}
  </Container>
</div>
